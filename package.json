{
  "name": "civilisation-effondrement",
  "private": true,
  "version": "1.0.0",
  "description": "Effondrement Idle — un jeu incrémental d'ascension et d'effondrement.",
  "author": "Raphael Ferrandis",
  "type": "module",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parcours": "vitest run src/game/core/__tests__/parcours --testTimeout=0",
    "electron": "electron .",
    "dist-win": "vite build && electron-builder --win",
    "dist-steam": "vite build && electron-builder --win dir -c.extraMetadata.civSteamBuild=true",
    "zip:web": "node scripts/zipDist.mjs"
  },
  "build": {
    "appId": "com.civilisationidle.game",
    "productName": "Effondrement Idle",
    "copyright": "© 2026 Raphael Ferrandis",
    "files": [
      "dist/**/*",
      "!dist/**/_orig/**",
      "!dist/**/_archive/**",
      "!dist/**/Asepritelayers/**",
      "main.cjs",
      "preload.cjs",
      "desktopFiles.cjs"
    ],
    "extraFiles": [
      {
        "from": "dist/licenses",
        "to": "licenses"
      }
    ],
    "directories": {
      "output": "../ce-release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "adm-zip": "^0.6.0",
    "break_infinity.js": "^2.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
